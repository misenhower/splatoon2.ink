# Nintendo SplatNet 2 "iksm_session" values
NINTENDO_SESSION_ID_NA=
NINTENDO_SESSION_ID_EU=
NINTENDO_SESSION_ID_JP=

# (Optional) User agent string for SplatNet requests
SPLATNET_USER_AGENT=

# (Optional) Google Analytics tracking ID
VUE_APP_GOOGLE_ANALYTICS_ID=

# (Optional) Sentry error reporting (https://sentry.io)
SENTRY_DSN=

# Screenshots for social posts: rendered from the deployed site by Cloudflare Browser Rendering
SITE_URL=https://splatoon2.ink
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BROWSER_RUN_API_TOKEN=

# (Optional) Bluesky API parameters
BLUESKY_SERVICE=https://bsky.social
BLUESKY_IDENTIFIER=splatoon2.ink # Handle or email address
BLUESKY_PASSWORD=
